<?xml version="1.0" encoding="utf-8"?>
<!-- Shuffle: two smooth crossing arrows, mirror images about the middle, drawn as rounded strokes.
     The rising one is broken where they cross, so the crossing reads clearly at small sizes.
     Tinted in code. -->
